# ============================================================
# SWEAT Turnstile Daemon — Environment Variables Template
# Copy this file to `.env.turnstile` (or `.env`) and fill in values
# before running `python sweat_turnstile_daemon.py`.
# ============================================================

# ── Studio / Branch ─────────────────────────────────────────
# Option A (single studio laptop): set SWEAT_BRANCH_ID
SWEAT_BRANCH_ID=cf447d73-a91b-4c0c-95d4-9fcf4844363c

# Option B (cloud multi-studio worker): comma-separated branch UUIDs (overrides SWEAT_BRANCH_ID)
# SWEAT_BRANCH_IDS=cf447d73-a91b-4c0c-95d4-9fcf4844363c,<andheri-uuid>,<goregaon-uuid>

# Tenant slug (do not change)
SWEAT_TENANT_SLUG=sweat

# Cloud API base URL (do not change)
SWEAT_API_BASE=https://api.sweatfitwellness.com

# ── Security ─────────────────────────────────────────────────
# Shared HMAC secret — MUST match `TURNSTILE_SYNC_SECRET` on the cloud server
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TURNSTILE_SYNC_SECRET=REPLACE_WITH_STRONG_SECRET

# Shared API key for `verify-punch/` — MUST match `TURNSTILE_GATEWAY_API_KEY` on the cloud server
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TURNSTILE_GATEWAY_API_KEY=REPLACE_WITH_STRONG_GATEWAY_KEY

# ── Terminal credentials ─────────────────────────────────────
# Admin username and password configured on Dahua / TimeWatch terminals
DAHUA_ADMIN_USER=admin
DAHUA_ADMIN_PASS=REPLACE_WITH_ACTUAL_PASSWORD

# ── Sync Tuning ──────────────────────────────────────────────
# How often (seconds) the daemon polls cloud for upcoming + cancelled bookings
SYNC_INTERVAL_SECONDS=60
# How often (seconds) cached cards are periodically re-asserted onto terminals
RESYNC_TTL_SECONDS=1800
